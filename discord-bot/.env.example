# ─── Discord ───────────────────────────────────────────────────────────────────

# Bot token — Discord Developer Portal → Your App → Bot → Token
DISCORD_TOKEN=your-discord-bot-token

# Application ID — Discord Developer Portal → Your App → General Information → Application ID
CLIENT_ID=123456789012345678

# Optional: restrict the slash command to one guild (server) for instant registration.
# Remove or leave empty to register globally (takes up to 1 hour to propagate).
#GUILD_ID=123456789012345678

# ─── Repository ────────────────────────────────────────────────────────────────

# Absolute path to the local clone of your wallpaper GitHub repository
REPO_PATH=/home/user/repos/wallpaper-server

# Base URL for raw GitHub file access — do NOT include a trailing slash
# Format: https://raw.githubusercontent.com/<user>/<repo>/refs/heads/<branch>
GITHUB_RAW_BASE=https://raw.githubusercontent.com/my-user/wallpaper-server/refs/heads/main

# Subdirectory inside the repo where images are stored (relative to repo root)
IMAGE_SUBDIR=images

# Path of the JSON manifest file (relative to repo root)
JSON_FILE=wallpaper.json

# Branch the bot commits and pushes to (e.g. main). Use when bot/app code lives on another branch.
GIT_BRANCH=main

# ─── Git identity ──────────────────────────────────────────────────────────────

GIT_USER_NAME=discord-bot
GIT_USER_EMAIL=bot@example.com

# ─── Commit strategy ───────────────────────────────────────────────────────────
# Set to "true" to amend+force-push instead of adding new commits.
# This prevents binary blob history from accumulating and keeps the repo tiny.
# Set to "false" (or omit) to use regular commits (simpler but repo grows over time).
AMEND_COMMITS=true
